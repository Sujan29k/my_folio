# Vercel / Next.js: server-only backend address. Existing NEXT_PUBLIC_API_URL
# is also supported when API_URL is not set.
API_URL=http://localhost:3001
ADMIN_PASSWORD=replace-with-a-new-private-password
ADMIN_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long
# Must match ADMIN_API_TOKEN on Render. Never prefix any admin secret NEXT_PUBLIC_.
ADMIN_API_TOKEN=replace-with-a-separate-random-server-token
